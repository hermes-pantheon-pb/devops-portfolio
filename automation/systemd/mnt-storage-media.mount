[Unit]
Description=NFS Mount for Centralized Storage Pool (OMV)
After=network-online.target
Wants=network-online.target

[Mount]
What=192.168.40.10:/export/media
Where=/mnt/storage/media
Type=nfs
Options=_netdev,auto,nofail,ro,nfsvers=4.2,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2
TimeoutSec=30

[Install]
WantedBy=multi-user.target
